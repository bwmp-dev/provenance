{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.provenance.dev/attestation/v1/schema.json",
  "title": "Provenance attestation envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mediaType", "statement", "signature"],
  "properties": {
    "mediaType": {
      "const": "application/vnd.provenance.attestation.v1+json"
    },
    "statement": {
      "$ref": "#/$defs/statement"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "minecraftVersion": {
      "type": "string",
      "pattern": "^1\\.(?:[1-9]|[1-9][0-9])(?:\\.(?:0|[1-9][0-9]*))?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "subject",
        "source",
        "configuration",
        "dependencies",
        "environments",
        "assertions",
        "runner",
        "verifiedAt"
      ],
      "properties": {
        "apiVersion": {
          "const": "provenance.dev/attestation/v1"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "configuration": {
          "$ref": "#/$defs/configuration"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/environment"
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sizeBytes", "digest"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\\\u0000]+\\.jar$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "commit", "ref"],
      "properties": {
        "provider": {
          "const": "github"
        },
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 201,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "ref": {
          "type": "string",
          "minLength": 6,
          "maxLength": 255,
          "pattern": "^refs/(?:heads|tags)/[^\\u0000-\\u0020~^:?*\\[\\]\\\\]+$"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "digest"],
      "properties": {
        "apiVersion": {
          "const": "provenance.dev/v1"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "sourceId",
        "version",
        "digest",
        "resolvedAt",
        "metadataDigest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "provider": {
          "enum": ["modrinth", "organization-upload"]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "resolvedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
        },
        "metadataDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "minecraftVersion",
        "paperBuild",
        "javaVersion",
        "runnerImageDigest",
        "policy",
        "outcome"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "provider": {
          "const": "paper"
        },
        "minecraftVersion": {
          "$ref": "#/$defs/minecraftVersion"
        },
        "paperBuild": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "javaVersion": {
          "type": "integer",
          "minimum": 8,
          "maximum": 99
        },
        "runnerImageDigest": {
          "$ref": "#/$defs/digest"
        },
        "policy": {
          "enum": ["required", "informational"]
        },
        "outcome": {
          "enum": ["passed", "failed"]
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "environmentId", "type", "outcome", "evidenceDigest"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "environmentId": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "startup-ready",
            "plugin-enabled",
            "dependency-present",
            "console-regex",
            "clean-shutdown"
          ]
        },
        "outcome": {
          "enum": ["passed", "failed", "skipped"]
        },
        "evidenceDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "imageDigest", "networkMode"],
      "properties": {
        "kind": {
          "enum": ["gvisor", "container", "process"]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "imageDigest": {
          "$ref": "#/$defs/digest"
        },
        "networkMode": {
          "enum": ["none", "restricted", "allowlist", "unrestricted"]
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hosting", "trust", "version", "sandbox"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "hosting": {
          "enum": ["hosted", "self-hosted"]
        },
        "trust": {
          "enum": ["provenance-hosted", "organization-reported"]
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "sandbox": {
          "$ref": "#/$defs/sandbox"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "hosting": {
                "const": "hosted"
              }
            },
            "required": ["hosting"]
          },
          "then": {
            "type": "object",
            "properties": {
              "trust": {
                "const": "provenance-hosted"
              },
              "sandbox": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "gvisor"
                  }
                }
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "trust": {
                "const": "organization-reported"
              }
            }
          }
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "keyId", "value"],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{85}[AEIMQUYcgkosw048]$"
        }
      }
    }
  }
}
