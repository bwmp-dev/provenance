{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.provenance.dev/key-discovery/v1/schema.json",
  "title": "Provenance public key discovery v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "keys"],
  "properties": {
    "version": { "const": 1, "type": "integer" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "description": "Complete snapshot, including retired keys. keyId values must be unique; enforce this semantic constraint in addition to JSON Schema validation.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm", "publicKey", "status"],
        "properties": {
          "keyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
          },
          "algorithm": { "const": "Ed25519", "type": "string" },
          "publicKey": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
            "description": "Canonical unpadded base64url of exactly 32 raw Ed25519 public-key bytes."
          },
          "status": { "type": "string", "enum": ["active", "retired"] }
        }
      }
    }
  }
}
